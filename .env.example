# Copy to .env (gitignored). Leave empty to run the fixtures demo.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=fixtures|sandbox (default: sandbox when keys are set, else fixtures)

# AI (optional). With none of these set, a deterministic fallback runs and everything still works.
# AI_PROVIDER=auto|anthropic|openai|codex|none   (auto: Claude if ANTHROPIC_API_KEY is set, else the
#                                                 OpenAI-compatible API if AI_MODEL is set; codex only when named)
# Claude:
ANTHROPIC_API_KEY=
# Any OpenAI-compatible chat-completions API (OpenAI, Mistral, Groq, OpenRouter, Ollama, llama-server, LM Studio...):
# AI_MODEL=                    required for this provider: the model name your endpoint expects
# AI_BASE_URL=https://api.openai.com/v1   e.g. http://localhost:11434/v1 for Ollama
# AI_API_KEY=                  or OPENAI_API_KEY; leave empty for a local server
# AI_TIMEOUT=120               seconds; raise it for a slow local model
# OpenAI through the Codex CLI with a ChatGPT plan (no API key; run `codex login` first):
# AI_PROVIDER=codex
# AI_MODEL=gpt-6-sol            the model your plan offers in Codex
# CODEX_BIN=                    path to codex, if it isn't on PATH

# Webhooks (optional, `make webhooks`): the id printed by tools/webhook_setup.py
# PAYPAL_WEBHOOK_ID=
# CASHDESK_TRUST_CF_CONNECTING_IP=1   only behind a Cloudflare tunnel (cloudflared on this machine)

# Board (optional): extra host names the board may be reached at (comma-separated, *.example.com allowed)
# CASHDESK_ALLOWED_HOSTS=
